{
  "expo": {
    "name": "recover",
    "slug": "recover",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#028BFF",
    "primaryColor": "#028BFF",
    "ios": {
      "supportsTablet": true,
      "userInterfaceStyle": "dark",
      "backgroundColor": "#028BFF"
    },
    "android": {
      "package": "com.recover.app",
      "adaptiveIcon": {
        "backgroundColor": "#028BFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "userInterfaceStyle": "dark",
      "backgroundColor": "#028BFF",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "backgroundColor": "#028BFF"
    },
    "plugins": [
      "./plugins/withRecoverBlocker",
      "expo-font",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#028BFF",
          "image": "./assets/splash-winged.png",
          "resizeMode": "contain"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Recover uses your camera to ensure your phone remains face-down and undisturbed during your focus session."
        }
      ]
    ]
  }
}
