<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.recover.installer">

    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <permission android:name="com.recover.installer.permission.RECEIVE_STATUS" android:protectionLevel="signature" />
    <uses-permission android:name="com.recover.installer.permission.RECEIVE_STATUS" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/app_icon"
        android:label="Recover Installer"
        android:roundIcon="@drawable/app_icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.RecoverInstaller">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".InstallReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.recover.installer.INSTALL_STATUS" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
